    {
      "parameters": {
        "jsCode": "// Збираємо всі CN з усіх input items в один масив\nconst allCn = [];\n\nfor (const item of items) {\n  const memberOf = item.json.memberOf || '';\n\n  // Знаходимо всі фрагменти типу \"CN=....\"\n  const matches = memberOf.match(/CN=[^,]+/g) || [];\n\n  // Додаємо значення CN без \"CN=\" в загальний масив\n  for (const m of matches) {\n    allCn.push(m.replace(/^CN=/, '').trim());\n  }\n}\n\n// Повертаємо ОДИН item\nreturn [\n  {\n    json: {\n      cn: allCn,   // тут усі CN з усіх 125 items\n    },\n  },\n];\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        208
