    {
      "parameters": {
        "jsCode": "// WF3 — Node 3.2: Normalize Cloudflare context (Bearer token)\n// Input assumed:\n// - Current item has execution_payload + onboarding_id, domain_fqdn, jira_issue_key, etc.\n// - Previous node \"Select rows from a table\" (dns_provider_account) is connected and its output is the current $json\n//\n// Output:\n// - Adds `cf` object used by Cloudflare HTTP Request nodes\n// - Adds `cf_ready`, `cf_pages_ready`, and `cf_errors`\n\nfunction pick(obj, paths) {\n  for (const p of paths) {\n    const v = p.split('.').reduce((acc, k) => (acc && acc[k] !== undefined ? acc[k] : undefined), obj);\n    if (v !== undefined && v !== null && String(v).trim() !== '') return v;\n  }\n  return null;\n}\n\nconst j = $input.first().json;\n\n// Your DM row shape (from dns_provider_account table)\nconst dmId = pick(j, ['id']);\nconst dmName = pick(j, ['name']);\nconst dmEmail = pick(j, ['email']);\nconst dmToken = pick(j, ['api_key']); // Bearer token ✅\nconst dmCfAccountId = pick(j, ['cf_id', 'account_id', 'cloudflare_account_id']); // depends on your schema\n\n// Domain/Jira context (may come from upstream WF2 payload or Data Table)\nconst domainFqdn = pick(j, [\n  'execution_payload.domain.fqdn',\n  'execution_payload.domain_fqdn',\n  'domain_fqdn',\n  'domain',\n]);\n\nconst jiraKey = pick(j, [\n  'execution_payload.jira.issue_key',\n  'execution_payload.jira_issue_key',\n  'jira_issue_key',\n]);\n\nconst projectCode = pick(j, [\n  'execution_payload.domain.project_code',\n  'execution_payload.project_code',\n  'project_code',\n]);\n\n// Build CF context\nconst cf_errors = [];\nif (!dmToken) cf_errors.push('Missing Bearer token: dns_provider_account.api_key is empty');\nif (!dmId) cf_errors.push('Missing dns_provider_account.id (DM account id)');\n\nconst cf = {\n  // DM primary key (your internal ID for dns_provider_account)\n  dns_provider_account_id: dmId ? Number(dmId) : null,\n\n  // Cloudflare account_id for /accounts/{account_id} (needed for Pages API)\n  // If null -> still can do Zones/DNS (via /zones), but Pages add-domain won't work.\n  account_id: dmCfAccountId ?? null,\n\n  account_name: dmName ?? null,\n  account_email: dmEmail ?? null,\n\n  // Bearer token\n  api_token: dmToken ?? null,\n\n  // Convenience headers for HTTP nodes\n  headers: dmToken ? { Authorization: `Bearer ${dmToken}` } : {},\n\n  // Readiness flags\n  ready: cf_errors.length === 0,\n  pages_ready: cf_errors.length === 0 && !!dmCfAccountId,\n};\n\n// If account_id missing, warn explicitly (so you don't waste time debugging Pages later)\nif (!dmCfAccountId) {\n  cf_errors.push('Missing Cloudflare account_id (cf_id). Pages endpoint /accounts/{account_id}/... will NOT work until this is populated.');\n}\n\nreturn [{\n  ...j,\n  domain_fqdn: domainFqdn ?? null,\n  jira_issue_key: jiraKey ?? null,\n  project_code: projectCode ?? null,\n\n  cf,\n  cf_errors,\n  cf_ready: cf.ready,\n  cf_pages_ready: cf.pages_ready,\n}];\n"
      },
